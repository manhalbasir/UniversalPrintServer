<Window x:Class="UniversalPrintServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalPrint Server" Height="700" Width="680"
        Icon="Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- شعار UniversalPrinter: نفس هوية التطبيق على الهاتف -->
            <Border Background="White" Padding="20,20,20,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Image Source="Assets/banner.png" Stretch="Uniform" MaxHeight="210" HorizontalAlignment="Left" />
            </Border>

            <StackPanel Margin="24,16,24,24">

            <TextBlock Text="اجعل طابعتك متاحة لتطبيق UniversalPrinter على هاتفك" FontSize="13" Foreground="#78909C" Margin="0,0,0,20" TextWrapping="Wrap" />


            <!-- عنوان IP -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="عنوان IP الخاص بهذا الحاسوب" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" />
                    <TextBlock Text="أدخل هذا العنوان في تطبيق UniversalPrinter عند إضافة طابعة" FontSize="11" Foreground="#90A4AE" Margin="0,2,0,10" />
                    <ItemsControl x:Name="IpListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AdapterName}" FontWeight="Bold" FontSize="13" Foreground="#37474F" />
                                        <TextBlock Text="  —  " FontSize="13" Foreground="#B0BEC5" />
                                        <TextBlock Text="{Binding IpAddress}" FontSize="15" FontFamily="Consolas" Foreground="#1565C0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="نسخ" Padding="10,4" Click="CopyIpButton_Click" Tag="{Binding IpAddress}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="🔄 تحديث" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RefreshIp_Click" Padding="10,4" />
                </StackPanel>
            </Border>

            <!-- اختيار الطابعة -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الطابعة" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" Margin="0,0,0,8" />
                    <ComboBox x:Name="PrinterComboBox" Padding="8" FontSize="13" />
                    <Button Content="🔄 تحديث قائمة الطابعات" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RefreshPrinters_Click" Padding="10,4" />
                </StackPanel>
            </Border>

            <!-- مشاركة SMB/Samba -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="مشاركة Samba/SMB" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" />
                    <TextBlock Text="الطريقة الكلاسيكية — تعمل مع كل الطابعات التي ويندوز نفسه يستطيع الطباعة عليها" FontSize="11" Foreground="#90A4AE" Margin="0,2,0,10" TextWrapping="Wrap" />
                    <TextBlock x:Name="SmbStatusText" Text="غير مُفعّلة" FontSize="12" Foreground="#EF6C00" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EnableSmbButton" Content="تفعيل المشاركة" Padding="14,8" Background="#3F51B5" Foreground="White" Click="EnableSmb_Click" />
                        <Button x:Name="DisableSmbButton" Content="إيقاف المشاركة" Padding="14,8" Margin="8,0,0,0" Click="DisableSmb_Click" />
                        <Button x:Name="GuestAccessButton" Content="👤 تفعيل الوصول كضيف (بدون كلمة مرور)" Padding="14,8" Margin="8,0,0,0" Click="EnableGuest_Click" />
                    </StackPanel>
                    <TextBlock Text="بعد التفعيل، أضف الطابعة في التطبيق عبر: إضافة يدوية ← Samba، باسم الحاسوب/IP واسم المشاركة الظاهر أعلاه. فعّل خيار &quot;الاتصال كضيف&quot; في نفس شاشة الإضافة إن استخدمت زر الضيف هنا." FontSize="11" Foreground="#90A4AE" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- خادم RAW / JetDirect -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="خادم RAW / JetDirect (منفذ 9100)" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" />
                    <TextBlock Text="يعمل مع أي طابعة متصلة بويندوز، بصرف النظر عن نوع اتصالها الفعلي" FontSize="11" Foreground="#90A4AE" Margin="0,2,0,10" TextWrapping="Wrap" />
                    <TextBlock x:Name="RawStatusText" Text="متوقّف" FontSize="12" Foreground="#EF6C00" Margin="0,0,0,8" />
                    <CheckBox x:Name="GdiModeCheckBox" Content="طابعتي من نوع GDI / اقتصادية (Brother/Canon/Epson المنزلية)" FontSize="11" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartRawButton" Content="▶ تشغيل الخادم" Padding="14,8" Background="#2E7D32" Foreground="White" Click="StartRaw_Click" />
                        <Button x:Name="StopRawButton" Content="⏹ إيقاف الخادم" Padding="14,8" Margin="8,0,0,0" Click="StopRaw_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="بعد التشغيل، أضف الطابعة في التطبيق عبر: إضافة يدوية ← RAW/JetDirect، بعنوان IP أعلاه ومنفذ 9100. فعّل المربّع أعلاه إذا كانت طابعتك اقتصادية/GDI حتى تُطبَع عبر معالج PDF المسجَّل في ويندوز بدل الإرسال الخام المباشر (الذي لن يعمل بشكل صحيح مع هذا النوع من الطابعات)." FontSize="11" Foreground="#90A4AE" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- خادم IPP -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="خادم IPP (منفذ 631)" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" />
                    <TextBlock Text="البروتوكول الأحدث والأكثر توافقاً مع طابعات الشبكة الحديثة" FontSize="11" Foreground="#90A4AE" Margin="0,2,0,10" TextWrapping="Wrap" />
                    <TextBlock x:Name="IppStatusText" Text="متوقّف" FontSize="12" Foreground="#EF6C00" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartIppButton" Content="▶ تشغيل الخادم" Padding="14,8" Background="#2E7D32" Foreground="White" Click="StartIpp_Click" />
                        <Button x:Name="StopIppButton" Content="⏹ إيقاف الخادم" Padding="14,8" Margin="8,0,0,0" Click="StopIpp_Click" IsEnabled="False" />
                    </StackPanel>
                    <Border Background="#F5F6FA" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock FontSize="11" Foreground="#455A64" TextWrapping="Wrap">
                            <Run Text="إعدادات التطبيق: " FontWeight="Bold" />
                            <Run Text="البروتوكول = IPP، المنفذ = 631، المسار = /ipp/print" FontFamily="Consolas" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- خادم LPR/LPD -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="خادم LPR / LPD (منفذ 515)" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" />
                    <TextBlock Text="بروتوكول طابور طباعة كلاسيكي — بديل إن لم يعمل IPP أو RAW" FontSize="11" Foreground="#90A4AE" Margin="0,2,0,10" TextWrapping="Wrap" />
                    <TextBlock x:Name="LprStatusText" Text="متوقّف" FontSize="12" Foreground="#EF6C00" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartLprButton" Content="▶ تشغيل الخادم" Padding="14,8" Background="#2E7D32" Foreground="White" Click="StartLpr_Click" />
                        <Button x:Name="StopLprButton" Content="⏹ إيقاف الخادم" Padding="14,8" Margin="8,0,0,0" Click="StopLpr_Click" IsEnabled="False" />
                    </StackPanel>
                    <Border Background="#F5F6FA" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock FontSize="11" Foreground="#455A64" TextWrapping="Wrap">
                            <Run Text="إعدادات التطبيق: " FontWeight="Bold" />
                            <Run Text="البروتوكول = LPR/LPD، المنفذ = 515، اسم الطابور = أي قيمة (لا يُتحقَّق منها)" FontFamily="Consolas" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- خادم FTP -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="خادم FTP (منفذ 21)" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" />
                    <TextBlock Text="مجلد طباعة ساخن — أي ملف يُرفع يُطبع فوراً" FontSize="11" Foreground="#90A4AE" Margin="0,2,0,10" TextWrapping="Wrap" />
                    <TextBlock x:Name="FtpStatusText" Text="متوقّف" FontSize="12" Foreground="#EF6C00" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartFtpButton" Content="▶ تشغيل الخادم" Padding="14,8" Background="#2E7D32" Foreground="White" Click="StartFtp_Click" />
                        <Button x:Name="StopFtpButton" Content="⏹ إيقاف الخادم" Padding="14,8" Margin="8,0,0,0" Click="StopFtp_Click" IsEnabled="False" />
                    </StackPanel>
                    <Border Background="#F5F6FA" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock FontSize="11" Foreground="#455A64" TextWrapping="Wrap">
                            <Run Text="إعدادات التطبيق: " FontWeight="Bold" />
                            <Run Text="البروتوكول = FTP، المنفذ = 21، اسم المستخدم/كلمة المرور = أي قيمة، المسار = /" FontFamily="Consolas" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- سجل الأحداث -->
            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="سجل الأحداث" FontWeight="SemiBold" FontSize="13" Foreground="#455A64" Margin="0,0,0,8" />
                    <TextBox x:Name="LogTextBox" Height="140" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                             Background="#FAFAFA" BorderThickness="0" />
                </StackPanel>
            </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
